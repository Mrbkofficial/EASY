// Nova Storefront — data model.
// Products live in source control (src/data/products.ts). The database only
// stores orders, so nothing customer-facing depends on an external service
// being reachable at build time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  // Short human-friendly reference shown to the customer, e.g. "NV-8F3K2Q".
  reference String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status  OrderStatus @default(PENDING)
  // How the customer paid: "stripe" or "paypal".
  provider String?
  // Provider-side id (Stripe session id / PayPal order id) for reconciliation.
  providerRef String?

  // Amounts are stored in minor units (cents) to avoid floating point errors.
  subtotal Int
  shipping Int    @default(0)
  total    Int
  currency String @default("usd")

  // Customer + shipping details (collected at checkout).
  email     String
  name      String
  phone     String?
  address1  String
  address2  String?
  city      String
  state     String?
  postal    String
  country   String

  // Fulfillment: has the owner placed the matching supplier order yet?
  fulfilled       Boolean   @default(false)
  fulfilledAt     DateTime?
  fulfillmentNote String?

  items OrderItem[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Snapshot of the product at purchase time (products can change later).
  productId String
  title     String
  image     String
  variant   String?
  unitPrice Int // minor units
  quantity  Int
  // Private supplier link — only ever shown in the owner's admin dashboard.
  sourceUrl String?
}

enum OrderStatus {
  PENDING // checkout created, payment not yet confirmed
  PAID // payment captured — this is when the owner gets notified
  FULFILLED // supplier order placed
  CANCELLED
  REFUNDED
}
