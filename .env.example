# ============================================================================
# Nova Storefront — environment variables
# Copy to .env (local) or set these in your host's dashboard (Vercel etc.).
# The site builds and runs without these, but payments/notifications stay off
# until the relevant ones are filled in.
# ============================================================================

# ---- Database (required for orders) ----
# A Postgres connection string. On Vercel, create a Postgres store and it adds
# this automatically. Locally you can use a free Neon/Supabase database.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Public site URL (used in links inside notifications & redirects) ----
NEXT_PUBLIC_SITE_URL="https://your-store.com"

# ---- Branding (optional — sensible defaults if omitted) ----
NEXT_PUBLIC_STORE_NAME="Nova & Co."
NEXT_PUBLIC_CURRENCY="usd"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"
NEXT_PUBLIC_SUPPORT_EMAIL="support@your-store.com"
# Flat shipping fee in cents, and free-shipping threshold in cents (0 disables).
NEXT_PUBLIC_SHIPPING_CENTS="499"
NEXT_PUBLIC_FREE_SHIP_CENTS="3500"

# ---- Stripe (cards + Apple Pay + Google Pay) ----
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard -> Developers -> Webhooks -> add endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- PayPal ----
# developer.paypal.com -> Apps & Credentials -> your app
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# The client id is ALSO needed in the browser to render the PayPal buttons:
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# "sandbox" while testing, "live" when you go live.
PAYPAL_ENV="sandbox"

# ---- Telegram sale notifications ----
# 1. Message @BotFather -> /newbot -> copy the token below.
# 2. Send your new bot any message.
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---- Admin dashboard (owner-only order management) ----
# The password you'll type at /admin/login.
ADMIN_PASSWORD="change-me-to-something-strong"
# Extra salt for the admin session cookie. openssl rand -base64 24
ADMIN_SECRET=""
